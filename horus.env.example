# Horus Feeds-Gateway -- CAI Application environment variables.
# Set these on the Application (not in source). Values in <...> are yours.

# --- Live mode: NiFi -> Kafka -> gateway (Streams Messaging Data Hub) ---
KAFKA_BROKERS=<broker0>:9093,<broker1>:9093,<broker2>:9093
KAFKA_USER=<workload-user>
KAFKA_PASSWORD=<workload-password>
KAFKA_TOPIC=horus-events
KAFKA_GROUP_ID=horus-feeds-gateway

# --- Lake: TimeTravel and lakehouse mode (Impala through Knox) ---
HIVE_HOST=<data-mart-datahub-gateway-host>
HIVE_HTTP_PATH=<datahub-name>/cdp-proxy-api/impala
HIVE_PORT=443
HIVE_USE_SSL=true
HIVE_USER=<workload-user>
HIVE_PASSWORD=<workload-password>
HIVE_DATABASE=horus
HIVE_TABLE=events_iceberg

# --- Source mode: live | lakehouse (switch at runtime with POST /mode) ---
GATEWAY_SOURCE_MODE=live
REPLAY_HOURS=3
REPLAY_SPEED=1.0

# --- Graph / intel / LLM ---
INTEL_URL=https://horus-intel.<domain>
NEO4J_URI=bolt://<memgraph-host>:7687
NEO4J_USER=<graph-user>
NEO4J_PASSWORD=<graph-password>
LLM_PROVIDER=openai
OPENAI_BASE_URL=<cai-inference-endpoint>/v1
OPENAI_API_KEY=<token>
OPENAI_MODEL=<model-id>
