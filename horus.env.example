# Horus Feeds-Gateway -- CAI Application environment variables.
# Set these on the Application (not in source). Values in <...> are yours.

# --- Provisioner (provision/horus.py) ---
# CDP access key: needed only while provisioning; remove it afterwards.
CDP_ACCESS_KEY_ID=<access-key-id>
CDP_PRIVATE_KEY=<private-key>
HORUS_INSTANCE=<short-id, e.g. dev>        # names: horus-<id>-events, horus_<id>, horus-<id>-kafka
HORUS_ENVIRONMENT=<cdp-environment-name>
HORUS_WORKBENCH=<workbench-name>
HORUS_NIFI_DATAHUB=<existing NiFi 2 Data Hub>   # default horus-<id>-nifi
HORUS_LAKE_VW=<existing CDW Impala or Trino virtual warehouse>
# HORUS_KAFKA_DATAHUB=horus-<id>-kafka      # default; created if missing
# HORUS_KAFKA_DEFINITION=                   # default: Streams Messaging Light Duty matching the Data Lake runtime
# HORUS_FLINK_DATAHUB=horus-<id>-flink      # default; created if missing
# HORUS_FLINK_DEFINITION=                   # default: Streaming Analytics Light Duty matching the Data Lake runtime
HORUS_WORKLOAD_USER=<workload-user>
HORUS_WORKLOAD_PASSWORD=<workload-password>
HORUS_AISSTREAM_API_KEY=<aisstream.io key>      # vessels flow
HORUS_HTTP_CONTACT=<email or URL>              # User-Agent contact for adsb.lol / NWS
HORUS_OPENSKY_CLIENT_ID=<client id>            # OpenSky API client (account page); flights OpenSky flow
HORUS_OPENSKY_CLIENT_SECRET=<client secret>

# The provisioner fills in the gateway values below (run `status` to see them).

# --- Live mode: NiFi -> Kafka -> gateway (Streams Messaging Data Hub) ---
KAFKA_BROKERS=<broker0>:9093,<broker1>:9093,<broker2>:9093
KAFKA_USER=<workload-user>
KAFKA_PASSWORD=<workload-password>
KAFKA_TOPIC=horus-<id>-events
KAFKA_GROUP_ID=horus-<id>-feeds-gateway

# --- Lake: TimeTravel and lakehouse mode (CDW virtual warehouse) ---
LAKE_ENGINE=trino                 # trino | impala
LAKE_CATALOG=iceberg              # trino only
HIVE_HOST=<vw-name>.<dw-domain>   # trino; for impala: coordinator-<vw-name>.<dw-domain>
HIVE_HTTP_PATH=cliservice         # impala only
HIVE_PORT=443
HIVE_USE_SSL=true
HIVE_USER=<workload-user>
HIVE_PASSWORD=<workload-password>
HIVE_DATABASE=horus_<id>
HIVE_TABLE=events_iceberg

# --- Source mode: live | lakehouse (switch at runtime with POST /mode) ---
GATEWAY_SOURCE_MODE=live
REPLAY_HOURS=3
REPLAY_SPEED=1.0

# --- Graph / intel / LLM ---
INTEL_URL=https://horus-intel.<domain>
NEO4J_URI=bolt://<memgraph-host>:7687
NEO4J_USER=<graph-user>
NEO4J_PASSWORD=<graph-password>
# LLM (feeds-gateway). Mistral Studio by default; for air-gapped sites point
# LLM_BASE_URL at the on-prem Mistral or Cloudera AI Inference endpoint instead.
LLM_BASE_URL=https://api.mistral.ai/v1
LLM_API_KEY=<mistral-api-key>
LLM_MODEL=mistral-large-4
# Optional: "none" skips Large 4's reasoning step for faster answers; "high" forces it.
# LLM_REASONING_EFFORT=none
